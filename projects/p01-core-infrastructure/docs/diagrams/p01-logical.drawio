          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="switch" value="Halden-LAN — private Hyper-V switch — 192.168.10.0/24" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0f766e;strokeColor=none;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="1040" height="26" as="geometry" />
