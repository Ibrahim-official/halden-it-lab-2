        <mxCell id="title" value="Halden Distribution Ltd — P1 logical architecture&#10;Isolated home lab · flat LAN 192.168.10.0/24 in P1 · domain ad.halden.internal" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1090" height="50" as="geometry" />
        </mxCell>
