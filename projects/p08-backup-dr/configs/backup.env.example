# P8 backup env file — TEMPLATE. Where it applies: BKP01 (copy to /etc/halden-lab/backup.env).
#
# This file contains PLACEHOLDERS ONLY and is safe to commit.
# The REAL file (/etc/halden-lab/backup.env) must:
#   * be created on BKP01 only, by the operator, copied from this template;
#   * be readable only by root (chmod 600, owned root:root);
#   * NEVER be committed to Git, pasted into chat, or put on the website;
#   * have its secrets stored in the owner's password manager as the source of truth.
#
# Losing the restic passphrase means losing every backup. Escrow it: password manager AND a
# sealed printed copy stored with the offline USB (docs/00-design.md §10).

# --- On-site restic repository (Copy 1) ---
HALDEN_BACKUP_ROOT=/srv/backup
RESTIC_REPOSITORY=/srv/backup/restic
# Path to a file that contains only the passphrase (do not put the passphrase itself here):
RESTIC_PASSWORD_FILE=/etc/halden-lab/restic.pass

# --- Offsite object store (Copy 2) — MinIO in the lab, S3/B2/Wasabi in production ---
# Replace the placeholders below with real values ONLY in the uncommitted copy on BKP01.
MINIO_ENDPOINT=https://minio.halden.internal:9000
MINIO_ROOT_USER=REPLACE_WITH_ADMIN_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_WITH_ADMIN_SECRET_KEY
MINIO_BACKUP_ACCESS_KEY=REPLACE_WITH_BACKUP_WRITER_ACCESS_KEY
MINIO_BACKUP_SECRET_KEY=REPLACE_WITH_BACKUP_WRITER_SECRET_KEY
MINIO_BUCKET=halden/backup-immutable
OFFSITE_REPOSITORY=s3:https://minio.halden.internal:9000/backup-immutable/fs01

# --- Monitoring hand-off (P9 Uptime Kuma) ---
# The push URL is a secret token; generate it in Uptime Kuma and store it only here.
UPTIME_KUMA_PUSH_URL=http://ops01.ad.halden.internal:3001/api/push/REPLACE_WITH_PUSH_TOKEN

# --- Offline copy (Copy 3) ---
# Device path of the monthly encrypted USB when attached to BKP01 (never auto-mounted):
OFFLINE_USB_DEVICE=/dev/disk/by-label/HALDEN_BACKUP_USB

# --- Lab marker ---
# BKP01 is not domain-joined, so scripts require this marker file to run:
#   echo halden-lab | sudo tee /etc/halden-lab
HALDEN_LAB_MARKER=/etc/halden-lab
