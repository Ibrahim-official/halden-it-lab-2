<mxfile host="app.diagrams.net" agent="halden-it-lab" version="24.7.17">
  <diagram id="p8-architecture" name="P8 backup and DR data flow">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Halden Distribution Ltd — P8 backup, recovery and DR data flow&#10;3-2-1-1-0 backups · on-site repository on BKP01 (not domain-joined) · immutable offsite copy · weekly verified restores · restore path back to production" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1090" height="56" as="geometry" />
        </mxCell>

        <mxCell id="production" value="Production (VLAN 10 / 30)&#10;&#10;DC01, DC02 — AD · DNS · DHCP&#10;FS01 — Finance / Sales shares&#10;LNX01 — order app + database&#10;OPS01 — GLPI · Uptime Kuma&#10;SIEM01 — Wazuh manager&#10;FW01, WS01 — config + workstations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="240" height="300" as="geometry" />
        </mxCell>

        <mxCell id="copy1" value="Copy 1 — on-site repository&#10;BKP01 · 192.168.10.42 · MGMT VLAN 40 (P6)&#10;&#10;restic repository (or PBS datastore)&#10;VM-level (checkpoint/VSS) + file-level&#10;DC system state via wbadmin (AD-aware)&#10;repository encrypted at rest&#10;prune + verify jobs on a schedule&#10;&#10;Not domain-joined: if AD falls, backups do not." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8;fontColor=#0f766e;" vertex="1" parent="1">
          <mxGeometry x="340" y="100" width="250" height="200" as="geometry" />
        </mxCell>

        <mxCell id="copy2" value="Copy 2 — offsite object store&#10;MinIO S3 (lab) · B2 / Wasabi (prod)&#10;&#10;bucket backup-immutable&#10;Object Lock: COMPLIANCE 30 days&#10;versioning + lifecycle rule&#10;restic forget --keep-* --prune&#10;delete markers only while locked&#10;&#10;Immutable: deletion refused, even for admins." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8;fontColor=#7c3aed;" vertex="1" parent="1">
          <mxGeometry x="650" y="100" width="240" height="200" as="geometry" />
        </mxCell>

        <mxCell id="copy3" value="Copy 3 — offline copy (air gap)&#10;&#10;encrypted USB (LUKS / VeraCrypt)&#10;latest repository + latest VM&#10;disconnected, stored off-site&#10;rotation log with dates&#10;unreachable from the network" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b45309;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8;fontColor=#b45309;" vertex="1" parent="1">
          <mxGeometry x="950" y="100" width="220" height="200" as="geometry" />
        </mxCell>

        <mxCell id="e_prod_copy1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1" source="production" target="copy1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l_nightly" value="nightly" style="text;html=1;fontSize=10;fontColor=#0f766e;" vertex="1" parent="1">
          <mxGeometry x="285" y="190" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="e_copy1_copy2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1" source="copy1" target="copy2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l_copy" value="restic copy" style="text;html=1;fontSize=10;fontColor=#0f766e;" vertex="1" parent="1">
          <mxGeometry x="595" y="190" width="70" height="20" as="geometry" />
        </mxCell>
        <mxCell id="e_copy2_copy3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b45309;strokeWidth=2;dashed=1;" edge="1" parent="1" source="copy2" target="copy3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l_monthly" value="monthly" style="text;html=1;fontSize=10;fontColor=#b45309;" vertex="1" parent="1">
          <mxGeometry x="895" y="190" width="60" height="20" as="geometry" />
        </mxCell>

        <mxCell id="verify" value="Verification — weekly automated restore test (Test-BackupRestore)&#10;20 random files restored and SHA-256 compared · restic check --read-data-subset=5% · one VM restored into sandbox VLAN 99 (no uplink)&#10;and a service health check run · JSON + HTML report · push to Uptime Kuma (P9) · 12-week history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;fontSize=11;align=left;verticalAlign=middle;spacing=8;fontColor=#134e4a;" vertex="1" parent="1">
          <mxGeometry x="340" y="330" width="560" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e_restore" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#0f766e;strokeWidth=2;dashed=1;" edge="1" parent="1" source="verify" target="production">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l_restore" value="restore / DR rebuild → RTO targets from the BIA" style="text;html=1;fontSize=10;fontColor=#0f766e;" vertex="1" parent="1">
          <mxGeometry x="300" y="400" width="240" height="20" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="The 3-2-1-1-0 rule for Halden&#10;&#10;3 copies: production + on-site + offsite     ·     2 media: disk repository + object/USB     ·     1 offsite: object store outside the LAN&#10;1 immutable / offline: Object Lock + rotated USB     ·     0 errors on verified restore: restore tested every week" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="1130" height="70" as="geometry" />
        </mxCell>

        <mxCell id="notjoined" value="Why BKP01 is not domain-joined&#10;&#10;Domain Admin hands out the keys to everything on the domain. If the domain is compromised, a joined backup server is compromised too. BKP01 keeps its own local credentials, sits in the MGMT VLAN and is reachable only on the backup ports — so the last line of defence survives." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="555" height="110" as="geometry" />
        </mxCell>
        <mxCell id="targets" value="Targets, not achievements&#10;&#10;The RTO/RPO figures in the BIA are targets agreed with the business. Actual recovery times are filled in only after a timed drill has been run. Halden Distribution Ltd. is a fictional company; the configurations are real and every measured number comes from a real run in this lab." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="615" y="530" width="555" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Home lab · isolated private switch, never the home network · backup repository passphrases and object-store keys are held outside the repository and escrowed offline · every RTO/RPO is a target until a drill measures it." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="40" y="655" width="1130" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
