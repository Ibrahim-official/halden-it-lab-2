          <mxGeometry x="60" y="230" width="320" height="58" as="geometry" />
        </mxCell>
        <mxCell id="t0deny" value="Deny logon to Tier 1 servers and every workstation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="302" width="320" height="46" as="geometry" />
        </mxCell>
