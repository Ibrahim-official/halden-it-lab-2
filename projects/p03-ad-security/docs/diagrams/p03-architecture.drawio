        <mxCell id="title" value="Halden Distribution Ltd — P3 privileged access and assessment loop&#10;Isolated home lab · domain ad.halden.internal · lab-only assessment with free tools (PingCastle, Purple Knight, BloodHound CE, Windows LAPS)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;spacing=2;" vertex="1" parent="1">
