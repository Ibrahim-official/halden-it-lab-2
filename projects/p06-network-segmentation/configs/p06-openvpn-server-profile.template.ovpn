# P6 OpenVPN road-warrior server profile template
# What this is: the client profile template for the Halden remote-access VPN (OpenVPN on FW01).
# Where it applies: exported by FW01 (OPNsense, VPN > OpenVPN > Client Export) to each staff laptop.
# READ THIS BEFORE COMMITTING AN EXPORTED PROFILE:
#   - The real profile contains a unique client certificate and private key for one person.
#   - Those are secrets. They are generated on FW01 and delivered to the user through the agreed
#     secure channel. They never go into this repository and never into the website.
#   - This template keeps placeholders only, so the shape of the profile can be reviewed in Git.
# Placeholders (replace on the device, never here):
#   <CLIENT_CERTIFICATE>  PEM issued to this user from the OpenVPN client template on the CA
#   <CLIENT_PRIVATE_KEY>  PEM generated on FW01 for this user; stored only in the password manager
#   <TLS_STATIC_KEY>      shared tls-auth/tls-crypt key generated on FW01
#   <VPN_HOSTNAME>        the tunnel endpoint as published to staff (lab: not a public address)

client
dev tun
proto udp
remote <VPN_HOSTNAME> 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
cipher AES-256-GCM
data-ciphers AES-256-GCM:AES-128-GCM
auth SHA256
verb 3

# Mutual TLS: the server proves itself to the client, the client proves itself to the server.
<ca>
-----BEGIN CERTIFICATE-----
<HALDEN_ROOT_CA_PUBLIC_CERTIFICATE>
-----END CERTIFICATE-----
</ca>

# tls-auth / tls-crypt: drop packets that are not from a peer holding this static key.
key-direction 1
<tls-crypt>
#
# 2048 bit OpenVPN static key - GENERATED ON FW01, NOT COMMITTED
#
-----BEGIN OpenVPN Static key V1-----
<PLACEHOLDER_NOT_A_REAL_KEY>
-----END OpenVPN Static key V1-----
</tls-crypt>

<cert>
-----BEGIN CERTIFICATE-----
<CLIENT_CERTIFICATE>
-----END CERTIFICATE-----
</cert>

<key>
-----BEGIN PRIVATE KEY-----
<CLIENT_PRIVATE_KEY>
-----END PRIVATE KEY-----
</key>

# Authentication: the tunnel certificate only identifies the device. The user must still pass
# NPS/RADIUS (AD group G_VPN_Users) and a second factor (Entra MFA or OPNsense TOTP).
auth-user-pass

# Design decisions (see ../docs/00-design.md section 7):
#  - Split tunnel: only the internal lab routes (the 192.168.x zones) are pushed to the client,
#    so ordinary web browsing does not flow through FW01.
#  - The server pushes the internal routes and the DC as the DNS server, so name resolution inside
#    the tunnel still goes through the domain and egress filtering still applies.
#  - Tunnel network: 192.168.70.0/24 (the VPN-USERS zone).
