<mxfile host="app.diagrams.net" agent="halden-it-lab" version="24.7.17">
  <diagram id="p6-architecture" name="P6 zone architecture, VPN and Wi-Fi">
    <mxGraphModel dx="1400" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Halden Distribution Ltd — P6 zone architecture, remote access and Wi-Fi&#10;Isolated home lab · deny-by-default between zones · rule matrix as CSV and Markdown" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1090" height="50" as="geometry" />
        </mxCell>
        <mxCell id="internet" value="Internet / home LAN&#10;(never touched by the lab)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="natsw" value="Hyper-V Default Switch&#10;(NAT — WAN side of FW01 only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="100" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fw01" value="FW01 — OPNsense (HQ)&#10;802.1Q trunk · every zone gateway&#10;rule set · DHCP relay · OpenVPN · WireGuard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#0f766e;" vertex="1" parent="1">
          <mxGeometry x="530" y="90" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="vpn" value="Remote-access VPN with MFA&#10;certificate per device → NPS/RADIUS on FS01&#10;AD group G_VPN_Users + Authenticator push / TOTP&#10;tunnel 192.168.70.0/24 · user parity, MGMT denied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontSize=11;fontColor=#78350f;" vertex="1" parent="1">
          <mxGeometry x="850" y="90" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fw02" value="FW02 — OPNsense (Warehouse)&#10;VLAN 20 · 192.168.20.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#0f766e;" vertex="1" parent="1">
          <mxGeometry x="930" y="200" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-internet-nat" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1" source="internet" target="natsw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-nat-fw01" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1" source="natsw" target="fw01"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-fw01-vpn" value="OpenVPN 1194" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b45309;dashed=1;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="fw01" target="vpn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-fw01-fw02" value="WireGuard S2S · tunnel 10.99.0.0/30 · UDP 51820&#10;allowed IPs restricted to the remote LAN" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#0f766e;strokeWidth=3;fontSize=10;" edge="1" parent="1" source="fw01" target="fw02"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="trunk" value="VLAN-aware trunk (802.1Q) — one tagged interface per zone" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0f766e;strokeColor=none;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="1140" height="26" as="geometry" />
        </mxCell>
        <mxCell id="e-fw01-trunk" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1" source="fw01" target="trunk"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="v10" value="VLAN 10 · SERVERS&#10;192.168.10.0/24&#10;DCs · FS01 (NPS) · LNX01&#10;OPS01 · SIEM01 · CA01&#10;static · Tier 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="175" height="120" as="geometry" />
        </mxCell>
        <mxCell id="v20" value="VLAN 20 · WAREHOUSE&#10;192.168.20.0/24&#10;site 2 clients and scanners&#10;behind FW02&#10;DHCP via relay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="230" y="340" width="175" height="120" as="geometry" />
        </mxCell>
        <mxCell id="v30" value="VLAN 30 · USERS-HQ&#10;192.168.30.0/24&#10;staff workstations&#10;and laptops&#10;DHCP via relay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="340" width="175" height="120" as="geometry" />
        </mxCell>
        <mxCell id="v40" value="VLAN 40 · MGMT&#10;192.168.40.0/24&#10;PAW (WS02) · hypervisor&#10;switch/AP management · BKP01&#10;reachable only from itself" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="340" width="175" height="120" as="geometry" />
        </mxCell>
        <mxCell id="v50" value="VLAN 50 · GUEST&#10;192.168.50.0/24&#10;visitor devices&#10;internet only&#10;client isolation · vouchers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="340" width="175" height="120" as="geometry" />
        </mxCell>
        <mxCell id="v60" value="VLAN 60 · IOT&#10;192.168.60.0/24&#10;printers · CCTV DVR&#10;warehouse scanners&#10;one allowed path: FS01 SMB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="340" width="190" height="120" as="geometry" />
        </mxCell>
        <mxCell id="wifi" value="Wi-Fi — certificate-based, no shared password&#10;&#10;Halden-Corp · 802.1X / EAP-TLS · VLAN 30&#10;certificate from the internal CA · NPS checks the device&#10;&#10;Halden-Guest · voucher portal · VLAN 50&#10;client isolation · cannot reach any company system&#10;&#10;PKI: CA01 Enterprise Root CA → autoenrolled device certificates." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="486" width="360" height="164" as="geometry" />
        </mxCell>
        <mxCell id="matrix" value="Rule matrix summary — deny by default, first match wins&#10;&#10;allow  USERS-HQ → SERVERS   DNS 53, Kerberos 88, LDAP/GC, SMB 445, RPC 135/49152–65535&#10;allow  USERS-HQ / VPN-USERS → FS01 SMB 445, OPS01 HTTPS 443, internet 80/443&#10;allow  WAREHOUSE → DCs and FS01 across the tunnel      allow  IOT → FS01 SMB (scan-to-folder)&#10;allow  MGMT → any internal (administration from the PAW only)&#10;deny   GUEST → any internal        deny any → MGMT        deny VPN-USERS → MGMT&#10;deny   DNS to non-DCs (53/853)     deny SMB/RDP to the internet     deny + log everything else" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="486" width="530" height="164" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Legend&#10;&#10;— allowed / routed&#10;&#10;- - VPN with MFA&#10;&#10;[ deny + log ]&#10;&#10;[ trust boundary ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="970" y="486" width="210" height="164" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Lab note: Halden Distribution Ltd. is a fictional company. The lab is isolated — it never exposes a service to the internet, and no wide-area address is recorded anywhere in this project.&#10;The network WAN side is the hypervisor's default NAT switch. Every flow in this diagram is a deliberate, documented exception to a default deny; the full matrix is in configs/p06-zone-rule-matrix.csv.&#10;Design shown; verification is the automated segmentation test suite run from a host in each zone. Results are published only once measured." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="1140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-trunk-zones" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1" source="trunk" target="v30"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-trunk-v40" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1" source="trunk" target="v40"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
