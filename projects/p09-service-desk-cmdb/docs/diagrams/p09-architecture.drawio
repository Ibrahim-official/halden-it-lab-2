        <mxCell id="glpiGroup" value="Service desk + CMDB (GLPI)&#10;&#10;halden-glpi — GLPI 10 · tickets, SLA, KB, CMDB&#10;halden-glpi-db — MariaDB (backend network only)&#10;&#10;Assets · software · licences · contracts&#10;Categories · priorities · SLAs (TTO/TTR)&#10;L1 to L2 to vendor escalation&#10;Self-service forms · email collector&#10;Knowledge base (10+ articles)&#10;Renewal alerts at 90 / 30 days&#10;&#10;Reconciled weekly vs DHCP + nmap — target: 0 unknown-on-network" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;fontSize=10.5;align=left;verticalAlign=top;spacing=8;fontStyle=1;fontColor=#134e4a;" vertex="1" parent="1">
