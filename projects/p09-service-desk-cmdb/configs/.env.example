# =============================================================================
# Halden Distribution Ltd. — P9 service desk stack environment (TEMPLATE)
# What it is: example environment file for configs/docker-compose.yml on OPS01.
# Where it applies: copy to /opt/halden/.env on OPS01 (scripts/00-Prepare-OPS01.sh
#                   does this for you) and fill in the placeholders.
# SECRETS: the real .env holds passwords and API tokens. It is git-ignored
#          (.gitignore: *.env / .env.*) and must NEVER be committed or pasted
#          into chat. Store a copy of the values in the owner's password manager.
# Every value below is a PLACEHOLDER. Generate real passwords with, e.g.:
#   openssl rand -base64 24
# and a BookStack APP_KEY (exactly 32 base64 chars) with:
#   docker run --rm lscr.io/linuxserver/bookstack:latest php artisan key:generate --show
# =============================================================================

# --- Time zone and internal base URLs ----------------------------------------
TZ=Asia/Karachi
GLPI_URL=https://glpi.halden.internal
BOOKSTACK_URL=https://bookstack.halden.internal
KUMA_URL=https://kuma.halden.internal

# Bind the web front ends to loopback and publish them through the reverse
# proxy only (the reverse proxy and its certificate arrive with the P6 AD CS).
GLPI_HTTP_BIND=127.0.0.1
KUMA_HTTP_BIND=127.0.0.1
BOOKSTACK_HTTP_BIND=127.0.0.1

# --- GLPI database (MariaDB) -------------------------------------------------
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=CHANGE_ME_glpi_db_password
GLPI_DB_ROOT_PASSWORD=CHANGE_ME_glpi_root_password
# GLPI application token for the REST API (scripts read it as GLPI_APP_TOKEN).
# Generated in GLPI: Setup -> API -> add a client, then copy the app token.
GLPI_APP_TOKEN=CHANGE_ME_glpi_app_token

# --- BookStack database + app key --------------------------------------------
BOOKSTACK_DB_NAME=bookstack
BOOKSTACK_DB_USER=bookstack
BOOKSTACK_DB_PASSWORD=CHANGE_ME_bookstack_db_password
BOOKSTACK_DB_ROOT_PASSWORD=CHANGE_ME_bookstack_root_password
BOOKSTACK_APP_KEY=CHANGE_ME_base64_32_char_app_key
# BookStack API token pair for scripts/10-Seed-BookStack.sh (Settings -> API Tokens).
BOOKSTACK_API_TOKEN_ID=CHANGE_ME_token_id
BOOKSTACK_API_TOKEN_SECRET=CHANGE_ME_token_secret

# --- Uptime Kuma -------------------------------------------------------------
# Uptime Kuma prompts for its admin user on first login; no password is stored
# here. The P8 backup heartbeat uses a PUSH monitor: MONITORING generates the
# push URL in the Kuma UI, P8 curls it after a successful restore test.
KUMA_HEARTBEAT_TOKEN=CHANGE_ME_kuma_push_token

# --- Offsite backup copy (P8 dependency, optional) ---------------------------
# Leave empty to keep the nightly service-desk dump local-only until P8 exists.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
