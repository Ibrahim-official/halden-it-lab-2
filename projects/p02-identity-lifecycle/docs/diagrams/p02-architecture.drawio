        </mxCell>
        <mxCell id="hr" value="HR system export&#10;data/hr-export.csv · nightly&#10;keyed on EmployeeID · SYNTHETIC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="1">
