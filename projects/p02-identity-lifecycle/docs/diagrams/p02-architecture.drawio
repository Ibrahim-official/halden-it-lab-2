        </mxCell>
        <mxCell id="exception" value="Exception request&#10;GLPI / request form&#10;approved by the department head" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="196" width="230" height="72" as="geometry" />
        </mxCell>
        <mxCell id="engine" value="Invoke-HaldenJML.ps1&#10;diffs HR desired state against AD&#10;&#10;-WhatIf dry run · circuit breaker &gt;10 % disables&#10;protected accounts · runs as a delegated gMSA&#10;&#10;JOINER · MOVER · LEAVER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;fontSize=11;fontColor=#0f766e;" vertex="1" parent="1">
          <mxGeometry x="305" y="110" width="280" height="158" as="geometry" />
        </mxCell>
        <mxCell id="ad" value="Active Directory (P1)&#10;department OUs · AGDLP G_ / DL_ groups&#10;FS01 home drives and shares&#10;OU=Disabled for leavers&#10;extensionAttribute1 = JML-Managed&#10;identity-hygiene report (phase 2)&#10;access-review export (phase 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="110" width="250" height="158" as="geometry" />
