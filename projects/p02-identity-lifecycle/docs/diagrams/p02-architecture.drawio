          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eEngineAd" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0f766e;" edge="1" parent="1" source="engine" target="ad">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="audit" value="Evidence and audit trail (append-only)&#10;logs/jml-audit.csv — timestamp, action, target, before, after, operator · logs/leavers/&lt;EmployeeID&gt;.json · reports/orphans.csv · reports/identity-hygiene-&lt;date&gt;.html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="352" width="830" height="56" as="geometry" />
