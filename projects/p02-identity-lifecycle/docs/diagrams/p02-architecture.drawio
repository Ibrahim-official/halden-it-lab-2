          <mxGeometry x="40" y="20" width="1090" height="50" as="geometry" />
        </mxCell>
        <mxCell id="hdrOn" value="1 · On-premises lifecycle (source of truth to access)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#0f766e;" vertex="1" parent="1">
