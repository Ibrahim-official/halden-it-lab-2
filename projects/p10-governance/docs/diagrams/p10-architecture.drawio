<mxfile host="app.diagrams.net" modified="2026-10-02T00:00:00.000Z" agent="p10-governance" version="24.0.0" type="device">
  <diagram id="p10-architecture" name="P10 governance loop">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Halden Distribution Ltd — P10 IT governance loop" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="The capstone that measures and reports on P1–P9 · CIS Controls v8.1 IG1 (56 safeguards) · change control · monthly KPI report · management review" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1000" height="22" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="1. Objectives &amp; controls&#10;&#10;Business objectives (grow orders, pass a&#10;supplier questionnaire, renew insurance)&#10;&#10;Sources: policy pack, CIS v8.1 IG1,&#10;configs/kpi-definitions.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="240" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="s2" value="2. Evidence from the nine projects&#10;&#10;P1 AD/DNS/DHCP/GPO · P2 identity/MFA/JML · P3 AD security&#10;P4 endpoint hardening · P5 patch/vulnerabilities · P6 network/VPN&#10;P7 SIEM/IR · P8 backup/DR · P9 GLPI/CMDB/docs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="340" y="100" width="520" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="s3" value="3. CIS IG1 self-assessment&#10;&#10;56 safeguards scored 0–3, before and after&#10;Rule: a score of 3 needs evidence&#10;&#10;data/cis-ig1-safeguards.csv&#10;scripts/cis_assessment.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="920" y="100" width="240" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="s4" value="4. Gaps &amp; risks&#10;&#10;Safeguards below 3 become register&#10;entries and roadmap items&#10;&#10;data/risk-register.csv&#10;owner = a business owner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="920" y="290" width="240" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="s5" value="5. Change management&#10;&#10;standard · normal · emergency&#10;weekly CAB, rollback required&#10;&#10;data/change-log.csv&#10;scripts/change_log.py → CAB agenda" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="620" y="290" width="250" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="s6" value="6. KPI dashboard &amp; report&#10;&#10;Repository-derived KPIs: real today&#10;Lab-measured KPIs: not measured yet&#10;&#10;scripts/collect_kpis.py&#10;scripts/monthly_report.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="300" y="290" width="270" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="s7" value="7. Management review&#10;&#10;One page, RAG status,&#10;a decision requested&#10;&#10;business/p10-monthly-it-report.md&#10;business/p10-state-of-it-talk.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="220" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="e12" style="endArrow=classic;html=1;strokeColor=#0f766e;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" style="endArrow=classic;html=1;strokeColor=#0f766e;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" style="endArrow=classic;html=1;strokeColor=#0f766e;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e45" style="endArrow=classic;html=1;strokeColor=#7c3aed;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e56" style="endArrow=classic;html=1;strokeColor=#0f766e;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e67" style="endArrow=classic;html=1;strokeColor=#0f766e;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="loop" value="Improvement: decisions become actions, actions become changes, changes update the controls — the loop repeats every month" style="endArrow=classic;html=1;strokeColor=#0f766e;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;fontSize=11.5;fontColor=#0f766e;" edge="1" parent="1" source="s7" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="legend" value="Legend&#10;&#10;→  data or control flow between governance stages&#10;→  change-management path (RFC → CAB → implementation)&#10;-- improvement loop back into the controls&#10;measured by this project (also touched by P1–P9)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;align=left;verticalAlign=top;spacing=10;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="496" width="520" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="notes" value="Where the numbers come from&#10;&#10;Repository-derived KPIs are computed by reading this repository (project readiness, evidence coverage, change and policy counts) — real measurements of the repository.&#10;Lab-measured KPIs (MFA coverage, patch compliance, restore tests) stay &quot;not measured&quot; until the lab has actually been executed. No number is estimated." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;align=left;verticalAlign=top;spacing=10;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="580" y="496" width="580" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="footnote" value="Halden Distribution Ltd. is a fictional 85-user company used for a home-lab portfolio. CIS Controls v8.1 IG1 = 56 safeguards across 15 controls (1–12, 14, 15, 17); controls 13, 16 and 18 have no IG1 safeguards." style="text;html=1;fontSize=11;align=left;fontColor=#64748b;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="1120" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
